DATABASE_URL=postgresql+psycopg://training_test:TrainingTestOnly_ChangeMe@127.0.0.1:15433/training_r2_test
JWT_SECRET=REPLACE_WITH_EXISTING_JWT_SECRET
JWT_ALGORITHM=HS256
REDIS_URL=redis://127.0.0.1:16380/0
IS_PRODUCTION=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
R2_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY
R2_BUCKET=training-private-videos
# 后端与 Worker 配置完全相同的独立随机密钥，至少32字节。
PLAYBACK_TOKEN_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
VIDEO_WORKER_BASE_URL=https://REPLACE_WORKER_DOMAIN
PLAYBACK_TOKEN_TTL=300
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TRANSCODE_TIMEOUT_SECONDS=7200
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEST_ENVIRONMENT=1

# 大文件上传和画质；HLS_HEIGHTS 支持 360,480,720,1080,1440,2160。
MAX_UPLOAD_BYTES=8589934592
UPLOAD_PART_BYTES=16777216
UPLOAD_RETENTION_HOURS=48
HLS_HEIGHTS=720,1080,1440,2160
HLS_CRF=21
HLS_PRESET=medium
SMTP_USE_SSL=false
# 同主域建议 lax；前后端跨站部署需 none 并配合生产 HTTPS。
SESSION_COOKIE_SAMESITE=lax
